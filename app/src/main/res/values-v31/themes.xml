<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Android 12+ 的系统开屏（SplashScreen API）。

      系统默认会拿**应用图标**在屏幕正中画一个圆，盖在我们自己的
      windowBackground 之上 —— 观感是"系统画一个圆、我们画的图被压住"。
      （踩过：一开始以为是自己那层遮罩没生效，查了好几轮才发现是系统这层。）

      对策：把 windowSplashScreenAnimatedIcon 指到一个**透明**图，
      系统那层就等于什么都不画；背景色与我们的 @color/splash_bg 对齐，
      于是从系统开屏切到我们自己的 windowBackground 完全无感。

      ⚠️ 不要用 android:windowSplashScreenBehavior 去关图标：它的取值是枚举
         （default / no_background 之类），填数字会编译报
         "expected enum but got (raw string)"（踩过）。
      ⚠️ 也不要把 AnimatedIcon 指到我们那张开屏图：系统会按**圆形**遮罩裁切
         并放大到约 2/3 屏，圆角方图会被切成圆。
    -->
    <style name="SplashTheme" parent="@style/AppTheme">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
