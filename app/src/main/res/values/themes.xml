<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/launch_bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <!-- 提高信息密度：内边距 16->11，卡片间距 14->8，标题 16->15sp -->
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">11dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="CardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 卡片标题栏：标题占满左侧，动作品在右侧 -->
    <style name="CardTitleRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- 标题右侧的小动作按钮（镂空，颜色由 AccentTheme 下发）。
         2.1.0 按用户要求整体做大一档：字号 12->13sp、左右内边距 10->14dp、
         上下 5->8dp（「停用 / 管理 / 取消 / 新增 / 保存」都是这个样式） -->
    <style name="CardAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!--
      卡片底部那一排按钮（「保存」+「恢复默认值」）：比标题行的小按钮再大一档，
      **宽度按文字量走**（wrap_content，用户要求"大小根据文字数量来"），
      所以这里只给内边距和字号，不给宽度。颜色照样由 AccentTheme 下发。
    -->
    <style name="CardBottomAction" parent="CardAction">
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
    </style>

    <style name="StatusLine">        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    
    <!--
      按钮统一走"镂空"样式：背景（描边 + 文字色）由 AccentTheme 按当前角色发色
      动态下发，所以这里**不设 android:background**，只定尺寸与排版。
    -->
    <style name="PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BigButton" parent="PrimaryButton">
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

</resources>
