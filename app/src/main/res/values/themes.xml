<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
      开屏主题：windowBackground 直接就是开屏图。

      ⚠️ 为什么要有这一份：冷启动时 Activity 的布局还没测量完，系统会先拿
         windowBackground 顶上。不设的话会先闪一下纯色（@color/bg）再出内容。
         设成开屏图，系统在**第一帧**就把画面画出来。

      ⚠️ 深浅色只能靠 night 资源限定符（@color/splash_bg 在 values-night 里
         覆盖成黑色、splash_logo 在 drawable-night-* 里换成深色那张）：
         windowBackground 在 Activity 创建之前就要用，那时读不到
         SharedPreferences，所以这里跟随的是**系统**深浅色，
         与 App 内的"外观模式"设置无关。
    -->
    <style name="SplashTheme" parent="@style/AppTheme">
        <item name="android:windowBackground">@drawable/splash_bg</item>
    </style>

    <!-- 提高信息密度：内边距 16->11，卡片间距 14->8，标题 16->15sp -->
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">11dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="CardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 卡片标题栏：标题占满左侧，动作品在右侧 -->
    <style name="CardTitleRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- 标题右侧的小动作按钮（镂空，颜色由 AccentTheme 下发） -->
    <style name="CardAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="StatusLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    
    <!--
      按钮统一走"镂空"样式：背景（描边 + 文字色）由 AccentTheme 按当前角色发色
      动态下发，所以这里**不设 android:background**，只定尺寸与排版。
    -->
    <style name="PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BigButton" parent="PrimaryButton">
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

</resources>
