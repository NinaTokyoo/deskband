<?xml version="1.0" encoding="utf-8"?>
<!--
  二级菜单里的一行：一个角色名。行与行之间的横线由代码添加
  （见 MainActivity.buildSkinMenu）。

  ⚠️ 这里**不要**加 `android:background="?android:attr/selectableItemBackground"`：
     在 DeviceDefault 主题下那个 ripple 会被当成实心遮罩铺满整行，
     渲染成一条条灰带（实测如此）。点击反馈由代码给一个淡色背景即可。
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/txtSkinItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:maxLines="1"
    android:ellipsize="end"
    android:textSize="15sp" />
