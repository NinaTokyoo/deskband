<?xml version="1.0" encoding="utf-8"?>
<!--
  「确定删除 XX 吗？」二次确认弹窗的内容视图。

  ⚠️ 刻意**不用** android.app.AlertDialog 那套系统按钮：它的面板与按钮是
  DeviceDefault 的深色样式，跟整页"中性底 + 强调色描边"完全对不上（用户反馈）。
  这里用一个普通 Dialog + 这份布局，再交给 AccentTheme.apply 上色 ——
  于是它与卡片、按钮是同一套配色，换角色 / 切明暗也会跟着变。

  ⚠️ 根布局用 match_parent，**宽度由代码设**（屏幕宽 − 两侧各 24dp）：
  窗口默认是 WRAP_CONTENT，卡片描边会紧贴文字，看着像没有内边距。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/txtConfirmMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp" />

    <!-- 两个按钮与卡片标题栏里的动作按钮同款（镂空 + 强调色描边、文字中性） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnConfirmCancel"
            style="@style/CardAction"
            android:textSize="14sp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/custom_cancel" />

        <Button
            android:id="@+id/btnConfirmDelete"
            style="@style/CardAction"
            android:layout_marginStart="10dp"
            android:textSize="14sp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/custom_delete" />
    </LinearLayout>
</LinearLayout>
