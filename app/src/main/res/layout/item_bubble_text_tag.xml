<?xml version="1.0" encoding="utf-8"?>
<!--
  「气泡内容」-> 管理：一条内容 = **一整个横条**（用户 2026-10-16 重做）。

  横条右侧两个按钮，**列位置抄标题行**（在代码里按实测宽度设）：
    · 删除 / 确认  —— 与上方「新增」按钮同列；
    · 启用 / 已启用 —— 与上方「管理 / 收起 / 取消」按钮同列。
  两个按钮 `match_parent` 高 —— 于是与横条等高（用户要求）。

  · 内容最多**两行**，超出用省略号（3 个点，代码里自行截断后再补）；
  · 删除是就地两步：点「删除」本按钮变「确认」，同时**标题行右上角变成「取消」**；
    点确认才真删，点取消退回上一步（待确认状态取消）；
  · 「已启用」三个字必须**排在一行** —— 见 MainActivity 里对它的
    `isSingleLine` + 自动缩放字号的设置（列宽受"与收起对齐"约束，只能让字去适配宽度）。

  背景与文字色不在 XML 里写死：标签是动态视图，由 renderBubbleTextTags() 按当前
  强调色 / 明暗模式现给。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- 内容：最多**两行**（用户 2026-10-16 从三行改回两行），超出由代码截断并补 "..." -->
    <TextView
        android:id="@+id/txtBubbleTagText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtBubbleTagDelete"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1" />

    <TextView
        android:id="@+id/btnBubbleTagToggle"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true" />
</LinearLayout>
