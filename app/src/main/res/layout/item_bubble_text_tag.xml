<?xml version="1.0" encoding="utf-8"?>
<!--
  「气泡内容」-> 管理：一条内容 = [左边有边框的内容框] + [右边的删除/确定] + [右边的启用/已启用]。

  用户 2026-10-17 重排：
  · 内容**单独放在左边的框里**（描边只包住内容，按钮不再框在里面）；
  · 两个按钮**拿出来放到右边**，横向与上方标题行的「新增 / 管理(收起/取消)」两列对齐
    （宽度与间距都由 MainActivity 按标题行实测值下发）；
  · 三者**等高**：都 `match_parent`，行高取最高者。

  ⚠️ 内容最多两行、放不下由 BubbleTagTextView 在布局阶段截断并补 "..."（不是系统省略号）。
  ⚠️ 描边与文字色不在 XML 里写死：由 renderBubbleTextTags() 按当前强调色 / 明暗模式现给。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <!-- 内容框：描边只在这上面（背景在代码里给） -->
    <LinearLayout
        android:id="@+id/boxBubbleTagContent"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <com.dsh.deskpet.BubbleTagTextView
            android:id="@+id/txtBubbleTagText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtBubbleTagDelete"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1" />

    <TextView
        android:id="@+id/btnBubbleTagToggle"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true" />
</LinearLayout>
