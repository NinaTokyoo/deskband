<?xml version="1.0" encoding="utf-8"?>
<!--
  「气泡内容」-> 管理：一条内容的标签（内容 + 删除控件）。

  用户 2026-10-16 定的规则：
  · 一行一个标签；内容**最多两行**，超出用省略号（3 个点）；
  · 删除错号：只有一行时在整个标签的最后；两行时在**第二行最后**；
  · 「标签显示的内容应留出足够空间防止确认删除按钮与标签内容冲突」。

  ⚠️ 为什么用 FrameLayout + 给文字**预留整条右侧空间**，而不是像「自定义形象」那样
     两个控件并排：
     · 并排时删除控件只占右上（或右下）**一格**，两行文字会从它下面伸过去 —— 被遮挡；
     · 并排时文字的可用宽度 = 标签宽 − 删除控件宽，而那个宽度会随「✕ / 确认删除」
       两种形态变化 —— 一点错号文字就重新折行、标签跟着变高、字也跟着挪位。
     现在的做法：文字占满整行、但**右侧内边距固定留出槽位宽度**（代码里按槽宽 + 间距设），
     删除控件固定尺寸、贴在右下角。于是
       · 两行也不会被遮挡（文字根本不会画进预留区）；
       · 两种形态下文字可用宽度**完全一致**，切换时高度与字位纹丝不动；
       · 只有一行时控件落在该行末尾，两行时落在第二行末尾（右下角）。
  ⚠️ 槽位里的 ✕ 用 **end 对齐**（贴右），否则它会浮在槽位中间、离标签右边缘半个槽宽。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- 文字：占满整行（右侧内边距在代码里固定预留出槽位），**垂直居中** ——
         一行时槽位比文字高，居中后"✕ 就在这一行末尾"；两行时两者等高，控件自然落到第二行末尾 -->
    <TextView
        android:id="@+id/txtBubbleTagText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:textSize="14sp" />

    <!-- 删除控件：文字、字号、背景、**宽高**都在 MainActivity 里按状态给，
         XML 里只定"贴右下"这一件事 -->
    <TextView
        android:id="@+id/txtBubbleTagDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:gravity="end|center_vertical"
        android:maxLines="1" />
</FrameLayout>
