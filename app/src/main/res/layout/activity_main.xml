<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:focusableInTouchMode="true"
    android:background="@color/bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <!-- 切换形象：放在页面最上面 -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_skin" />

            <Spinner
                android:id="@+id/spinnerSkin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/label_skin_hint"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 权限 -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_perm" />

            <TextView
                android:id="@+id/txtOverlayStatus"
                style="@style/StatusLine"
                android:text="@string/perm_overlay_off" />

            <Button
                android:id="@+id/btnOverlay"
                style="@style/PrimaryButton"
                android:text="@string/perm_overlay_btn_off" />

            <TextView
                android:id="@+id/txtNotifyStatus"
                style="@style/StatusLine"
                android:text="@string/perm_notify_off" />

            <Button
                android:id="@+id/btnNotify"
                style="@style/PrimaryButton"
                android:text="@string/perm_notify_btn_off" />
        </LinearLayout>

        <!-- 开关 -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_switch" />

            <Button
                android:id="@+id/btnToggle"
                style="@style/BigButton"
                android:text="@string/btn_start" />
        </LinearLayout>

        <!-- 外观 -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_look" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/label_size"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editSize"
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:maxLength="5"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:hint="@string/size_input" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSaveSize"
                style="@style/PrimaryButton"
                android:layout_marginTop="14dp"
                android:text="@string/bounce_save" />

            <CheckBox
                android:id="@+id/chkAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/chk_autostart"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 松手回弹调节 -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_bounce" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/bounce_hint"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <!-- 幅度 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_bounce_amp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekBounceAmp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtBounceAmp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editBounceAmp"
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:maxLength="5"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:hint="@string/bounce_amp_input" />
            </LinearLayout>

            <!-- 回落时长 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_bounce_ms"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekBounceMs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtBounceMs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editBounceMs"
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:maxLength="5"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:hint="@string/bounce_ms_input" />
            </LinearLayout>

            <!-- 保存并立刻应用到正在运行的桌宠 -->
            <Button
                android:id="@+id/btnSaveBounce"
                style="@style/PrimaryButton"
                android:layout_marginTop="16dp"
                android:text="@string/bounce_save" />
        </LinearLayout>

        <!-- 小提示 -->
        <LinearLayout style="@style/Card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tip"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="5dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
