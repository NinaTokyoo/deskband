<?xml version="1.0" encoding="utf-8"?>
<!--
  卡片式布局。每张卡片专注一件事：
    ① 开关 + 权限
    ② 形象切换 + 复位
    ③ 外观（大小倍率）
    ④ 松手回弹
    ⑤ 通知栏自定义
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg"
    android:overScrollMode="ifContentScrolls"
    android:scrollbarAlwaysDrawVerticalTrack="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <!-- 页面标题：在卡片之外，左右边距与下方卡片对齐（都是 16dp）。
             字号不写死、也不用 autoSizeTextType（它在 maxLines+ellipsize 组合下
             收敛不准，实测填不满），改由 MainActivity.fitTitleToWidth()
             量出实际可用宽度后精确设定 —— 加上这里的边距后，
             标题正好在卡片的左右边界之间填满。 -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:text="@string/ui_title"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <!-- ① 权限 + 开关 -->
        <LinearLayout style="@style/Card" android:tag="card" android:layout_marginStart="12dp" android:layout_marginEnd="12dp">

            <!-- 两个权限入口并排：文字靠左、标记靠右（两端对齐） -->

            <!-- 呼出/收起 + 复位：并排，左宽右窄（按草图）。
                 呼出/收起的文字含形象名，用 maxLines=1 保证绝不换行。 -->
            <Button
                android:id="@+id/btnToggle"
                style="@style/BigButton"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/btn_summon" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- 复位左沿 = 呼出左沿（都贴卡片内容区左边缘）
                     保留右沿 = 呼出右沿（都贴卡片内容区右边缘）
                     中间留白 = 呼出左边缘到卡片边框的距离 = 卡片内边距 13dp
                     所以中间用固定 13dp 的 Space，保留用 weight 吃掉剩余宽度。 -->
                <Button
                    android:id="@+id/btnReset"
                    style="@style/BigButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:minWidth="0dp"
                    android:maxLines="1"
                    android:text="@string/btn_reset" />

                <Space
                    android:layout_width="13dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnResetKeep"
                    style="@style/BigButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:minWidth="0dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/reset_keep_off" />
            </LinearLayout>
        </LinearLayout>

        <!-- ② 形象：右下角实时显示当前角色的「右下角」素材。
             clipToOutline 让素材的右下角被卡片的圆角切掉（用户要求）。
             素材不可交互：clickable/focusable 全关。

             ⚠️ 这张卡片自己 padding=0，内边距挪到里面的内容层 ——
             这样 FrameLayout 就占满整张卡片，素材用 layout_gravity=end|bottom
             且**不需要负外边距**就能贴到卡片边框。
             （试过负 marginEnd/-marginBottom，在 FrameLayout 里会被钳制，
               实测素材右边仍差 13dp。） -->
        <LinearLayout
            style="@style/Card"
            android:tag="card"
            android:padding="0dp"
            android:clipToOutline="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipToPadding="false"
                    android:padding="13dp">

                    <TextView
                        style="@style/CardTitle"
                        android:text="@string/section_skin" />

                    <!-- ⚠️ 宽度 = 卡片内容宽度的 2/3（用户要求）：名称框与展开的
                         二级菜单**同一款宽度**，所以它们一起塞进这个列容器里，
                         宽度只在一处定义，绝不会出现"上宽下窄"的台阶。

                         用权重 66:34 而不是写死 dp，换屏幕尺寸也不会跑偏。 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="66"
                            android:orientation="vertical">

                            <LinearLayout
                                android:id="@+id/boxSkin"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="12dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp">

                                <TextView
                                    android:id="@+id/txtSkinName"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:textSize="15sp" />

                                <ImageView
                                    android:id="@+id/icoSkinArrow"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_marginStart="8dp"
                                    android:src="@drawable/ic_triangle_down"
                                    android:clickable="false"
                                    android:focusable="false"
                                    android:importantForAccessibility="no" />
                            </LinearLayout>

                            <!-- 二级菜单：默认隐藏，点框展开。行间横线由代码加。
                                 外层负责"裁剪 + 高度"，内层才是真正的一列选项。
                                 -1dp 的 marginTop 把相接处两道描边叠成一道，
                                 这样名称框 + 菜单看起来是"一整块"。

                                 高度由内容决定（wrap_content）——
                                 不做展开动画，开合是即时切换。 -->
                            <LinearLayout
                                android:id="@+id/skinMenuWrap"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="-1dp"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <LinearLayout
                                    android:id="@+id/skinMenu"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 右侧留白：占 1/3，把上面的控件挤到卡片左侧 2/3 -->
                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="34" />
                    </LinearLayout>
                </LinearLayout>

                <!-- scaleType 必须是 matrix —— setImageMatrix 只在 matrix 下生效，
                     其它 scaleType 会忽略我们算好的矩阵（踩过：素材因此没贴紧）。

                     右边距/底边距 = 0.75dp = 卡片描边宽 1.5dp 的一半。
                     描边是 STROKE 样式、以卡片边界为中心画，所以可见描边只占
                     最外侧 0.75dp；留 0.75dp 正好让素材**紧贴描边内沿**：
                     既没有缝隙，也不会盖住描边。（留 2dp 会被看出缝隙，
                       留 0dp 会压住描边。） -->
                <ImageView
                    android:id="@+id/imgCornerPreview"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_gravity="end|bottom"
                                        android:layout_marginEnd="1dp"
                    android:layout_marginBottom="1dp"
                    android:scaleType="matrix"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>

        <!-- ②.5 自定义形象：默认就是**一横条**（标题 + 新增 / 管理），
             点「新增」向下展开成表单、点「管理」向下展开成标签列表。

             ⚠️ 两个展开区**互斥**，可见性只在 MainActivity.setCustomMode 一处改：
             同时展开会出现"表单下面挂着删除标签"的错位画面。

             卡片自己 padding=0？不需要 —— 这里没有像「当前形象」那样要贴边的素材，
             直接用 Card 样式的 11dp 内边距。 -->
        <LinearLayout
            style="@style/Card"
            android:tag="card"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">

            <LinearLayout style="@style/CardTitleRow">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/section_custom_skin" />

                <!-- 新增 / 保存：进入"新增"后这个按钮变成「保存」（用户要求） -->
                <Button
                    android:id="@+id/btnCustomAdd"
                    style="@style/CardAction"
                    android:text="@string/custom_add" />

                <Button
                    android:id="@+id/btnCustomManage"
                    style="@style/CardAction"
                    android:text="@string/custom_manage" />
            </LinearLayout>

            <!-- ============ 展开区一：新增表单（默认隐藏） ============ -->
            <LinearLayout
                android:id="@+id/panelCustomAdd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 名称行：**宽度 = 卡片内容宽度的 2/3**（用户要求"形象名称横线
                     右端到卡片左侧 2/3 处"），与「当前形象」的名称框同宽。
                     用权重 66:34 而不是写死 dp —— 换屏幕尺寸也不会跑偏。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="66"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:text="@string/custom_name_input" />

                        <EditText
                            android:id="@+id/editCustomName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:inputType="text"
                            android:imeOptions="actionDone"
                            android:maxLength="20"
                            android:maxLines="1"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- 右侧留白：占 1/3，把名称行挤到卡片左侧 2/3 -->
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="34" />
                </LinearLayout>

                <!-- 两个素材位并排，各占一半（用户草图）。
                     ⚠️ 用 weight 1:1 而不是写死宽度，换屏幕尺寸也不会一宽一窄。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:text="@string/custom_main_asset" />

                        <FrameLayout
                            android:id="@+id/boxCustomUpright"
                            android:layout_width="match_parent"
                            android:layout_height="112dp"
                            android:layout_marginTop="6dp"
                            android:tag="accentBox">

                            <ImageView
                                android:id="@+id/imgCustomUpright"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="4dp"
                                android:scaleType="fitCenter"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:id="@+id/txtPlusCustomUpright"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="+"
                                android:textSize="30sp"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:text="@string/custom_corner_asset" />

                        <FrameLayout
                            android:id="@+id/boxCustomCorner"
                            android:layout_width="match_parent"
                            android:layout_height="112dp"
                            android:layout_marginTop="6dp"
                            android:tag="accentBox">

                            <ImageView
                                android:id="@+id/imgCustomCorner"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="4dp"
                                android:scaleType="fitCenter"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:id="@+id/txtPlusCustomCorner"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="+"
                                android:textSize="30sp"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 素材要求提示（用户给定文案，一字不改）：放在两个素材位下面。
                     只提示"要透明底 PNG"，不展开讲姿态与尺寸 —— 那属于文档的事，
                     卡片里多一行就变说明书了。 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:text="@string/custom_asset_hint" />
            </LinearLayout>

            <!-- ============ 展开区二：管理（默认隐藏） ============
                 标签每行两个、由代码添加；奇数个时最后一个与左列对齐
                 （右侧补一个等宽 Space，见 MainActivity.renderCustomTags）。 -->
            <LinearLayout
                android:id="@+id/panelCustomManage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/rowsCustomManage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <!-- 空列表时的提示：本身不再留上边距，靠上面 rowsCustomManage 的
                     12dp —— 这样"有标签"与"没标签"两种情况下，与标题行的间隔一致 -->
                <TextView
                    android:id="@+id/txtCustomEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:text="@string/custom_empty" />
            </LinearLayout>
        </LinearLayout>

        <!-- ③ 外观 -->
        <LinearLayout style="@style/Card" android:tag="card" android:layout_marginStart="12dp" android:layout_marginEnd="12dp">

            <LinearLayout style="@style/CardTitleRow">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/section_look" />

                <Button
                    android:id="@+id/btnResetSize"
                    style="@style/CardAction"
                    android:text="@string/restore_default" />
            </LinearLayout>

            <!-- 标签 + 当前值 + 输入框挤在同一行，滑条紧随其下（提高密度） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editSize"
                    android:layout_width="66dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:maxLength="5"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:hint="@string/size_input" />
            </LinearLayout>

            <com.dsh.deskpet.ThumbSeekBar
                android:id="@+id/seekSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnSaveSize"
                style="@style/PrimaryButton"
                android:text="@string/save_apply" />
        </LinearLayout>

        <!-- ④ 呼出回弹（滑入 + 回摆那一段，独立于边框回弹） -->
        <LinearLayout style="@style/Card" android:tag="card" android:layout_marginStart="12dp" android:layout_marginEnd="12dp">

            <LinearLayout style="@style/CardTitleRow">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/section_summon" />

                <Button
                    android:id="@+id/btnSummonToggle"
                    style="@style/CardAction"
                    android:text="@string/summon_on" />

                <Button
                    android:id="@+id/btnResetSummon"
                    style="@style/CardAction"
                    android:text="@string/restore_default" />
            </LinearLayout>

            <!-- 总时长 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtSummonTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editSummonTime"
                    android:layout_width="66dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:maxLength="5"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:hint="@string/summon_input" />
            </LinearLayout>

            <com.dsh.deskpet.ThumbSeekBar
                android:id="@+id/seekSummonTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 弹出高度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtSummonPop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editSummonPop"
                    android:layout_width="66dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:maxLength="5"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:hint="@string/summon_input" />
            </LinearLayout>

            <com.dsh.deskpet.ThumbSeekBar
                android:id="@+id/seekSummonPop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 回弹幅度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtSummonSpring"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editSummonSpring"
                    android:layout_width="66dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:maxLength="5"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:hint="@string/summon_input" />
            </LinearLayout>

            <com.dsh.deskpet.ThumbSeekBar
                android:id="@+id/seekSummonSpring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnSaveSummon"
                style="@style/PrimaryButton"
                android:text="@string/save_apply" />
        </LinearLayout>

        <!-- ⑤ 松手回弹 -->
        <LinearLayout style="@style/Card" android:tag="card" android:layout_marginStart="12dp" android:layout_marginEnd="12dp">

            <LinearLayout style="@style/CardTitleRow">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/section_bounce" />

                <!-- 边框回弹总开关：标签显示当前状态，点击切换 -->
                <Button
                    android:id="@+id/btnBounceToggle"
                    style="@style/CardAction"
                    android:text="@string/bounce_on" />

                <Button
                    android:id="@+id/btnResetBounce"
                    style="@style/CardAction"
                    android:text="@string/restore_default" />
            </LinearLayout>

            <!-- 幅度：标签+值+输入框一行，滑条紧随 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtBounceAmp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editBounceAmp"
                    android:layout_width="66dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:maxLength="5"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:hint="@string/bounce_amp_input" />
            </LinearLayout>

            <com.dsh.deskpet.ThumbSeekBar
                android:id="@+id/seekBounceAmp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 时长 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtBounceMs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editBounceMs"
                    android:layout_width="66dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:maxLength="5"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:hint="@string/bounce_ms_input" />
            </LinearLayout>

            <com.dsh.deskpet.ThumbSeekBar
                android:id="@+id/seekBounceMs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnSaveBounce"
                style="@style/PrimaryButton"
                android:text="@string/save_apply" />
        </LinearLayout>

        <!-- ⑥ 呼吸 -->
        <LinearLayout style="@style/Card" android:tag="card" android:layout_marginStart="12dp" android:layout_marginEnd="12dp">

            <LinearLayout style="@style/CardTitleRow">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/section_breath" />

                <Button
                    android:id="@+id/btnBreathToggle"
                    style="@style/CardAction"
                    android:text="@string/breath_on" />

                <Button
                    android:id="@+id/btnResetBreath"
                    style="@style/CardAction"
                    android:text="@string/restore_default" />
            </LinearLayout>

            <!-- 速度：决定呼吸动画播得快慢（周期 = 基准 2600ms / 速度倍率） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtBreathSpeed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editBreathSpeed"
                    android:layout_width="66dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:maxLength="5"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:hint="@string/breath_input" />
            </LinearLayout>

            <com.dsh.deskpet.ThumbSeekBar
                android:id="@+id/seekBreathSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtBreathAmp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editBreathAmp"
                    android:layout_width="66dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:maxLength="5"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:hint="@string/breath_input" />
            </LinearLayout>

            <com.dsh.deskpet.ThumbSeekBar
                android:id="@+id/seekBreathAmp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnSaveBreath"
                style="@style/PrimaryButton"
                android:text="@string/save_apply" />
        </LinearLayout>

        <!-- ⑦ 通知栏自定义 -->
        <LinearLayout style="@style/Card" android:tag="card" android:layout_marginStart="12dp" android:layout_marginEnd="12dp">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_notify" />

            <!-- 标题：用 {name} 表示角色名 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:text="@string/notify_title_label" />

            <EditText
                android:id="@+id/editNotifyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:maxLength="40"
                android:maxLines="2"
                android:textSize="15sp"
                android:hint="@string/notify_title_input" />

            <TextView
                android:id="@+id/txtNotifyTitleCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- 正文 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:text="@string/notify_body_label" />

            <EditText
                android:id="@+id/editNotify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:maxLength="40"
                android:maxLines="2"
                android:textSize="15sp"
                android:hint="@string/notify_input" />

            <TextView
                android:id="@+id/txtNotifyCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSaveNotify"
                style="@style/PrimaryButton"
                android:layout_marginTop="10dp"
                android:text="@string/save_apply" />
        </LinearLayout>

        <!-- ⑥ 明暗模式：放在最下方（用户要求） -->
        <LinearLayout
            style="@style/Card"
            android:tag="card"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_theme" />

            <!-- 外观模式：一行三个按钮（用户要求），样式与其它按钮统一 ——
                     镂空描边由 AccentTheme 下发；**选中**的那个换成实心强调色，
                     否则三个按钮一模一样、看不出当前选的是哪个。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <Button
                        android:id="@+id/btnThemeSystem"
                        style="@style/CardAction"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="0dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/theme_system" />

                    <Button
                        android:id="@+id/btnThemeLight"
                        style="@style/CardAction"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/theme_light" />

                    <Button
                        android:id="@+id/btnThemeDark"
                        style="@style/CardAction"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/theme_dark" />
                </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Card" android:tag="card" android:layout_marginStart="12dp" android:layout_marginEnd="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:id="@+id/rowOverlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/txtPermOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/perm_overlay"
                        android:textColor="@color/accent"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/markOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:text="@string/perm_missing_mark" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowNotify"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/txtPermNotify"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/perm_notify"
                        android:textColor="@color/accent"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/markNotify"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:text="@string/perm_missing_mark" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
