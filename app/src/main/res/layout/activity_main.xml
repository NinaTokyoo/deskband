<?xml version="1.0" encoding="utf-8"?>
<!--
  卡片式布局。每张卡片专注一件事：
    ① 开关 + 权限
    ② 形象切换 + 复位
    ③ 外观（大小倍率）
    ④ 松手回弹
    ⑤ 通知栏自定义
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg"
    android:overScrollMode="ifContentScrolls"
    android:scrollbarAlwaysDrawVerticalTrack="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <!-- 页面标题：在卡片之外，左右边距与下方卡片对齐（都是 16dp）。
             字号不写死、也不用 autoSizeTextType（它在 maxLines+ellipsize 组合下
             收敛不准，实测填不满），改由 MainActivity.fitTitleToWidth()
             量出实际可用宽度后精确设定 —— 加上这里的边距后，
             标题正好在卡片的左右边界之间填满。 -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:text="@string/ui_title"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <!-- ① 权限 + 开关 -->
        <LinearLayout style="@style/Card" android:tag="card" android:layout_marginStart="16dp" android:layout_marginEnd="16dp">

            <!-- 两个权限入口并排：文字靠左、标记靠右（两端对齐） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:id="@+id/rowOverlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/txtPermOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/perm_overlay"
                        android:textColor="@color/accent"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/markOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:text="@string/perm_missing_mark" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowNotify"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/txtPermNotify"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/perm_notify"
                        android:textColor="@color/accent"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/markNotify"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:text="@string/perm_missing_mark" />
                </LinearLayout>
            </LinearLayout>

            <!-- 呼出/收起 + 复位：并排，左宽右窄（按草图）。
                 呼出/收起的文字含形象名，用 maxLines=1 保证绝不换行。 -->
            <Button
                android:id="@+id/btnToggle"
                style="@style/BigButton"
                android:layout_marginTop="12dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/btn_summon" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <Button
                    android:id="@+id/btnReset"
                    style="@style/BigButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:maxLines="1"
                    android:text="@string/btn_reset" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnResetKeep"
                    style="@style/BigButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/reset_keep_off" />
            </LinearLayout>
        </LinearLayout>

        <!-- ② 形象：右下角实时显示当前角色的「右下角」素材。
             clipToOutline 让素材的右下角被卡片的圆角切掉（用户要求）。
             素材不可交互：clickable/focusable 全关。

             ⚠️ 这张卡片自己 padding=0，内边距挪到里面的内容层 ——
             这样 FrameLayout 就占满整张卡片，素材用 layout_gravity=end|bottom
             且**不需要负外边距**就能贴到卡片边框。
             （试过负 marginEnd/-marginBottom，在 FrameLayout 里会被钳制，
               实测素材右边仍差 13dp。） -->
        <LinearLayout
            style="@style/Card"
            android:tag="card"
            android:padding="0dp"
            android:clipToOutline="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        style="@style/CardTitle"
                        android:text="@string/section_skin" />

                    <Spinner
                        android:id="@+id/spinnerSkin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="99dp"
                        android:popupAnimationStyle="@style/SpinnerPopupAnim" />
                </LinearLayout>

                <!-- 宽度要与上面 Spinner 的 marginEnd 配合：
                     marginEnd >= 图宽 + 8，否则会盖住 Spinner 右端的倒三角。
                     scaleType 必须是 matrix —— setImageMatrix 只在 matrix 下生效，
                     其它 scaleType 会忽略我们算好的矩阵（踩过：素材因此没贴紧）。

                     右边距/底边距 = 0.75dp = 卡片描边宽 1.5dp 的一半。
                     描边是 STROKE 样式、以卡片边界为中心画，所以可见描边只占
                     最外侧 0.75dp；留 0.75dp 正好让素材**紧贴描边内沿**：
                     既没有缝隙，也不会盖住描边。（留 2dp 会被看出缝隙，
                       留 0dp 会压住描边。） -->
                <ImageView
                    android:id="@+id/imgCornerPreview"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="1dp"
                    android:layout_marginBottom="1dp"
                    android:scaleType="matrix"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>

        <!-- ③ 外观 -->
        <LinearLayout style="@style/Card" android:tag="card" android:layout_marginStart="16dp" android:layout_marginEnd="16dp">

            <LinearLayout style="@style/CardTitleRow">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/section_look" />

                <Button
                    android:id="@+id/btnResetSize"
                    style="@style/CardAction"
                    android:text="@string/restore_default" />
            </LinearLayout>

            <!-- 标签 + 当前值 + 输入框挤在同一行，滑条紧随其下（提高密度） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editSize"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:maxLength="5"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:hint="@string/size_input" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnSaveSize"
                style="@style/PrimaryButton"
                android:text="@string/save_apply" />
        </LinearLayout>

        <!-- ④ 松手回弹 -->
        <LinearLayout style="@style/Card" android:tag="card" android:layout_marginStart="16dp" android:layout_marginEnd="16dp">

            <LinearLayout style="@style/CardTitleRow">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/section_bounce" />

                <!-- 边框回弹总开关：标签显示当前状态，点击切换 -->
                <Button
                    android:id="@+id/btnBounceToggle"
                    style="@style/CardAction"
                    android:text="@string/bounce_on" />

                <Button
                    android:id="@+id/btnResetBounce"
                    style="@style/CardAction"
                    android:text="@string/restore_default" />
            </LinearLayout>

            <!-- 幅度：标签+值+输入框一行，滑条紧随 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtBounceAmp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editBounceAmp"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:maxLength="5"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:hint="@string/bounce_amp_input" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBounceAmp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 时长 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtBounceMs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editBounceMs"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:maxLength="5"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:hint="@string/bounce_ms_input" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBounceMs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnSaveBounce"
                style="@style/PrimaryButton"
                android:text="@string/save_apply" />
        </LinearLayout>

        <!-- ⑤ 通知栏自定义 -->
        <LinearLayout style="@style/Card" android:tag="card" android:layout_marginStart="16dp" android:layout_marginEnd="16dp">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_notify" />

            <EditText
                android:id="@+id/editNotify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:maxLength="40"
                android:maxLines="2"
                android:textSize="15sp"
                android:hint="@string/notify_input" />

            <TextView
                android:id="@+id/txtNotifyCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSaveNotify"
                style="@style/PrimaryButton"
                android:layout_marginTop="10dp"
                android:text="@string/save_apply" />
        </LinearLayout>

        <!-- ⑥ 明暗模式：放在最下方（用户要求） -->
        <LinearLayout
            style="@style/Card"
            android:tag="card"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_theme" />

            <Spinner
                android:id="@+id/spinnerTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:popupAnimationStyle="@style/SpinnerPopupAnim" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
