<?xml version="1.0" encoding="utf-8"?>
<!--
  卡片式布局。每张卡片专注一件事：
    ① 开关 + 权限
    ② 形象切换 + 复位
    ③ 外观（大小倍率）
    ④ 松手回弹
    ⑤ 通知栏自定义
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:focusableInTouchMode="true"
    android:background="@color/bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <!-- ① 标题 + 权限 + 开关 -->
        <LinearLayout style="@style/Card">

            <!-- 标题：单行自适应，绝不换行 -->
            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="21sp"
                android:text="@string/ui_title"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <!-- 两个权限入口并排：文字靠左、标记靠右（两端对齐） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:id="@+id/rowOverlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/txtPermOverlay"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/perm_overlay"
                        android:textColor="@color/accent"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/markOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:text="@string/perm_missing_mark" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowNotify"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/txtPermNotify"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/perm_notify"
                        android:textColor="@color/accent"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/markNotify"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:text="@string/perm_missing_mark" />
                </LinearLayout>
            </LinearLayout>

            <!-- 呼出/收起：通栏大按钮。
                 文字带形象名，可能很长，所以单行 + 自动缩字号，
                 绝不换行（用户要求"防止人物名字过长导致换行"）。 -->
            <Button
                android:id="@+id/btnToggle"
                style="@style/BigButton"
                android:layout_marginTop="12dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="19sp"
                android:text="@string/btn_summon" />
        </LinearLayout>

        <!-- ② 形象与复位 -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_skin" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Spinner
                    android:id="@+id/spinnerSkin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnReset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/btn_primary_bg"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_accent"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_reset" />
            </LinearLayout>
        </LinearLayout>

        <!-- ③ 外观 -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_look" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/label_size"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editSize"
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:maxLength="5"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:hint="@string/size_input" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSaveSize"
                style="@style/PrimaryButton"
                android:layout_marginTop="14dp"
                android:text="@string/save_apply" />
        </LinearLayout>

        <!-- ④ 松手回弹 -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_bounce" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/label_bounce_amp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekBounceAmp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtBounceAmp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editBounceAmp"
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:maxLength="5"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:hint="@string/bounce_amp_input" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/label_bounce_ms"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekBounceMs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtBounceMs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editBounceMs"
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:maxLength="5"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:hint="@string/bounce_ms_input" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSaveBounce"
                style="@style/PrimaryButton"
                android:layout_marginTop="14dp"
                android:text="@string/save_apply" />
        </LinearLayout>

        <!-- ⑤ 通知栏自定义 -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_notify" />

            <EditText
                android:id="@+id/editNotify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:maxLength="40"
                android:maxLines="2"
                android:textSize="15sp"
                android:hint="@string/notify_input" />

            <TextView
                android:id="@+id/txtNotifyCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSaveNotify"
                style="@style/PrimaryButton"
                android:layout_marginTop="10dp"
                android:text="@string/save_apply" />
        </LinearLayout>

        <TextView
            style="@style/StatusLine"
            android:layout_marginTop="18dp"
            android:text="@string/tip" />
    </LinearLayout>
</ScrollView>
