<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标（Android 8.0+）。

  ⚠️ 为什么把图缩进安全区，而不是直接当 background 铺满：
     自适应图标只保证露出中心 66/108（安全区），其余按各厂商遮罩（圆、方、水滴…）
     裁掉。直接铺满的话四边会被裁 —— 用户明确要求"不要裁切图片"。所以：
       · background = 一层**纯色** @color/ic_launcher_bg
         （沿图片四边取样得到的底色）—— 被裁掉的只是这层纯色，与图同色，看不出区别
       · foreground = **整张图**缩到 61% 居中 —— 图完整落在安全区内，任何遮罩都裁不到

     深色版本：前景在 res/drawable-night-nodpi/ 同名文件，底色在 values-night/，
     由 night 资源限定符自动选（跟随**系统**深色模式）。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_bg" />
    <foreground android:drawable="@drawable/ic_launcher_fg" />
</adaptive-icon>
